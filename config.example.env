# warp-herdr-notifications configuration.
# Copy this file to the plugin config directory as config.env:
#   cp config.example.env "$(herdr plugin config-dir warp-herdr-notifications)/config.env"
# Every line is optional. The values below are the defaults.

# Agent states that send a notification (herdr states: idle working blocked done).
TRIGGER_STATUSES="blocked done"

# macOS sound names: Basso Blow Bottle Frog Funk Glass Hero Morse Ping Pop Purr
# Sosumi Submarine Tink, or any .aiff/.wav file name in ~/Library/Sounds
# (without the extension). Use "" for no sound.
# Run the install-herdr-sounds action, then use "HerdrInput" / "HerdrDone"
# for herdr's own sounds.
SOUND_BLOCKED="Ping"
SOUND_DONE="Glass"

# Notification titles. The agent name is added in front, e.g. "Claude: Finished".
TITLE_BLOCKED="Needs your input"
TITLE_DONE="Finished"

# 1 = no notification when the pane is focused in herdr and Warp is the front app.
SUPPRESS_WHEN_FOCUSED=1

# 1 = remove a notification when its agent starts working again or you view it.
CLEAR_ON_RESUME=1

# Warp app bundle id. Use "dev.warp.Warp-Preview" for Warp Preview.
WARP_BUNDLE_ID="dev.warp.Warp-Stable"

# Full path to the terminal-notifier binary. Empty = find it automatically.
NOTIFIER=""

# 1 = write logs and the last event to the plugin state directory.
DEBUG=0
